{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.GehDoc/svg-to-video",
  "title": "SVG to Video",
  "description": "Animated SVG to Video (MP4/WebM/MKV/MOV) and Animated Image (aPNG/GIF) converter",
  "version": "0.27.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/GehDoc/svg-to-video",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@gehdoc/svg-to-video",
      "version": "0.27.2",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "oci",
      "identifier": "docker.io/gehdoc/svg-to-video:latest",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
